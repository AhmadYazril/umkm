  <diagram id="DFD_Level_1_v7" name="DFD Level 1 - Pemetaan Fitur &amp; Role">
    <mxGraphModel dx="1600" dy="1015" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1015" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b&gt;DATA FLOW DIAGRAM (DFD) LEVEL 1: PEMETAAN FITUR &amp;amp; TUGAS ROLE SISTEM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;font-weight:normal;&quot;&gt;Sistem Informasi UMKM Nucomu Cafe • 3 Role Pengguna (Admin, Kasir, Pelanggan) &amp;amp; 12 Fitur Khusus&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="1480" height="64" as="geometry"/></mxCell>
        <mxCell id="3" value="&lt;b&gt;ROLE: ADMIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748B&quot;&gt;Pengelola Konten, Katalog &amp; Laporan&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• Login &amp; verifikasi hak akses panel Admin&lt;br&gt;• Kelola konten web publik (Banner, Fasilitas, Galeri, About, Event, Kontak)&lt;br&gt;• Kelola katalog menu, kategori, varian, stok &amp; arsip&lt;br&gt;• Filter &amp; ekspor rekap penjualan (PDF, CSV, Print)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#0F172A;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="42" y="118" width="344" height="256" as="geometry"/></mxCell>
        <mxCell id="4" value="&lt;b&gt;ROLE: KASIR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748B&quot;&gt;Operator POS, Pembayaran &amp; Stok&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• Login ke halaman operasional POS Kasir&lt;br&gt;• Scan QR slip Dine-In / Take Away, bayar &amp; cetak struk&lt;br&gt;• Cari kode #NCM-* Zendo, proses bayar &amp; serah pesanan&lt;br&gt;• Ubah stok &amp; ketersediaan menu secara real-time&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="42" y="416" width="344" height="256" as="geometry"/></mxCell>
        <mxCell id="5" value="&lt;b&gt;ROLE: PELANGGAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748B&quot;&gt;Pengunjung Website (Tanpa Login)&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• Pesan Dine-In / Take Away &amp; terima QR pemesanan&lt;br&gt;• Pesan online antar via Zendo &amp; arahkan ke WA Zendo&lt;br&gt;• Ajukan reservasi meja &amp; paket acara (tautan WA Admin)&lt;br&gt;• Kirim rating bintang, ulasan &amp; foto pengalaman&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontColor=#0F172A;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1214" y="714" width="344" height="256" as="geometry"/></mxCell>
        <mxCell id="6" value="&lt;b&gt;KETERANGAN PEMETAAN LEVEL 1&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;&lt;b style=&quot;color:#1E3A8A&quot;&gt;■ Admin (Proses 1.0 – 4.0)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#0F766E&quot;&gt;■ Kasir (Proses 5.0 – 8.0)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#6D28D9&quot;&gt;■ Pelanggan (Proses 9.0 – 12.0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 12 kotak proses berkorespondensi 1:1 dengan 12 diagram alur DFD Level 2.&lt;br&gt;• Mode Klien (3 Role): Kurir Zendo pihak ketiga di luar sistem.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.6;fontColor=#0F172A;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1214" y="118" width="344" height="256" as="geometry"/></mxCell>
        <mxCell id="7" value="&lt;b style=&quot;color:#1E3A8A&quot;&gt;1.0 — LOGIN ADMIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Autentikasi akun, hak akses &amp; status login panel Admin (/admin/login)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="112" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1E3A8A;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="246"/><mxPoint x="442" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="9" value="&lt;b style=&quot;color:#1E3A8A&quot;&gt;2.0 — KELOLA KONTEN WEBSITE (CRUD TERPADU)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Banner, Fasilitas, Galeri, Tentang Kafe (About), Event &amp; Kontak&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="182" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1E3A8A;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="3" target="9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="246"/><mxPoint x="442" y="210"/></Array></mxGeometry></mxCell>
        <mxCell id="11" value="&lt;b style=&quot;color:#1E3A8A&quot;&gt;3.0 — KELOLA MENU, KATEGORI, VARIAN &amp; STOK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;CRUD katalog menu, kategori, opsi varian, stok, arsip &amp; pulihkan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="252" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1E3A8A;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="3" target="11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="246"/><mxPoint x="442" y="280"/></Array></mxGeometry></mxCell>
        <mxCell id="13" value="&lt;b style=&quot;color:#1E3A8A&quot;&gt;4.0 — REKAP &amp; LAPORAN PENJUALAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Filter periode harian/mingguan/bulanan &amp; ekspor PDF, CSV / Print&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="322" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1E3A8A;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="3" target="13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="246"/><mxPoint x="442" y="350"/></Array></mxGeometry></mxCell>
        <mxCell id="15" value="&lt;b style=&quot;color:#115E59&quot;&gt;5.0 — LOGIN KASIR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Autentikasi operator &amp; status login halaman POS Kasir (/kasir/login)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="410" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0F766E;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="544"/><mxPoint x="442" y="438"/></Array></mxGeometry></mxCell>
        <mxCell id="17" value="&lt;b style=&quot;color:#115E59&quot;&gt;6.0 — PEMBAYARAN DINE-IN / TAKE AWAY (SCAN QR)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Scan QR slip pelanggan, konfirmasi pembayaran &amp; cetak struk 80mm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="480" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0F766E;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="544"/><mxPoint x="442" y="508"/></Array></mxGeometry></mxCell>
        <mxCell id="19" value="&lt;b style=&quot;color:#115E59&quot;&gt;7.0 — PEMBAYARAN &amp; PENYERAHAN PESANAN ZENDO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Cari kode #NCM-* / antrean Zendo, proses pembayaran &amp; cetak struk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="550" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0F766E;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="544"/><mxPoint x="442" y="578"/></Array></mxGeometry></mxCell>
        <mxCell id="21" value="&lt;b style=&quot;color:#115E59&quot;&gt;8.0 — UPDATE STOK &amp; KETERSEDIAAN MENU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Perbarui jumlah stok cepat &amp; status tersedia/habis pada layar POS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0F766E;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="544"/><mxPoint x="442" y="648"/></Array></mxGeometry></mxCell>
        <mxCell id="23" value="&lt;b style=&quot;color:#5B21B6&quot;&gt;9.0 — PEMESANAN DINE-IN / TAKE AWAY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Pilih menu &amp; varian, keranjang, checkout &amp; tampil QR untuk kasir&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="708" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6D28D9;endArrow=classic;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="5" target="23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1158" y="842"/><mxPoint x="1158" y="736"/></Array></mxGeometry></mxCell>
        <mxCell id="25" value="&lt;b style=&quot;color:#5B21B6&quot;&gt;10.0 — PEMESANAN ONLINE VIA ZENDO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Pilih menu, alamat antar, hitung ongkir &amp; arahkan ke WA Zendo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="778" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6D28D9;endArrow=classic;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="5" target="25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1158" y="842"/><mxPoint x="1158" y="806"/></Array></mxGeometry></mxCell>
        <mxCell id="27" value="&lt;b style=&quot;color:#5B21B6&quot;&gt;11.0 — PENGAJUAN RESERVASI MEJA &amp; ACARA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Isi form dinamis reservasi, simpan jadwal &amp; buka tautan WA Admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="848" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6D28D9;endArrow=classic;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="5" target="27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1158" y="842"/><mxPoint x="1158" y="876"/></Array></mxGeometry></mxCell>
        <mxCell id="29" value="&lt;b style=&quot;color:#5B21B6&quot;&gt;12.0 — KIRIM ULASAN PELANGGAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;Isi rating bintang, komentar &amp; unggah foto ulasan pelanggan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="918" width="600" height="56" as="geometry"/></mxCell>
